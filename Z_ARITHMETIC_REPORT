REPORT Z_ARITHMETIC_REPORT.
DATA:
LV_ADDITION TYPE I,
LV_SUBTRACTION TYPE I,
LV_MULTIPLICATION TYPE I,
LV_DIVISION TYPE I,
LV_REMAINDER TYPE I.

PARAMETERS:
P_A TYPE I,
P_B TYPE I.

LV_ADDITION = P_A + P_B.
LV_SUBTRACTION = P_A - P_B.
LV_MULTIPLICATION = P_A * P_B.
LV_DIVISION = P_A / P_B.
LV_REMAINDER = P_A MOD P_B.

WRITE:
/ 'ADDITION:',LV_ADDITION,
/ 'SUBTRACTION:',LV_SUBTRACTION,
/ 'MULTIPLICATION:',LV_MULTIPLICATION,
/ 'DIVISION:',LV_DIVISION,
/ 'REMAINDER:',LV_REMAINDER.
