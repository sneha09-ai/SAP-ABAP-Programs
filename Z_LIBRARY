REPORT Z_LIBRARY.
DATA BOOK_NO TYPE I VALUE 0.
PARAMETERS ANSWER TYPE C LENGTH 1.
WRITE: 'Do you want to borrow another book? Yes/No'.
WHILE BOOK_NO < 5 AND ANSWER = 'Y'.
  BOOK_NO = BOOK_NO + 1.
  WRITE:/ 'BORROWED BOOKS:',BOOK_NO.
  IF BOOK_NO = 5.
    WRITE: 'THIS IS MAXIMUM BOOK COUNT'.
    EXIT.
  ENDIF.
  ENDWHILE.
  WRITE:/ 'TOTAL BOOK COUNT:',BOOK_NO.
