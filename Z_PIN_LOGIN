REPORT Z_PIN_LOGIN.
PARAMETERS PIN1 TYPE N LENGTH 4.
PARAMETERS PIN2 TYPE N LENGTH 4.
DO 2 TIMES.
  if sy-index = 1.
  WRITE: /'LOGIN PIN CODE 1:',PIN1.
  IF PIN1 = 1234.
    WRITE: /'ACCESS GRANTED'.
    EXIT.
  ENDIF.
  ELSE.
    WRITE: /'LEGIN PIN CODE 2:',PIN2.

    IF PIN2 = 1234.
    WRITE: /'ACCESS GRANTED'.
    EXIT.
    ENDIF.

  ENDIF.
ENDDO.

IF PIN1 <> 1234 AND PIN2 <> 1234.
  WRITE:/ 'USER LOCKED'.
  ENDIF.
