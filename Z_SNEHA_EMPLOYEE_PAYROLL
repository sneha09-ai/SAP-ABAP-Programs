FUNCTION Z_SNEHA_EMPLOYEE_PAYROLL.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(BASIC_SALARY) TYPE  INT4
*"     REFERENCE(HRA_PERCENTAGE) TYPE  INT4
*"     REFERENCE(DA_PERCENTAGE) TYPE  INT4
*"     REFERENCE(PF_PERCENTAGE) TYPE  INT4
*"  EXPORTING
*"     REFERENCE(HRA_AMOUNT) TYPE  INT4
*"     REFERENCE(DA_AMOUNT) TYPE  INT4
*"     REFERENCE(PF_AMOUNT) TYPE  INT4
*"     REFERENCE(GROSS_SALARY) TYPE  INT4
*"     REFERENCE(NET_SALARY) TYPE  INT4
*"----------------------------------------------------------------------
HRA_AMOUNT = BASIC_SALARY * HRA_PERCENTAGE / 100.
DA_AMOUNT = BASIC_SALARY * DA_PERCENTAGE / 100.
PF_AMOUNT = BASIC_SALARY * PF_PERCENTAGE / 100.
GROSS_SALARY = BASIC_SALARY + HRA_AMOUNT + DA_AMOUNT.
NET_SALARY = GROSS_SALARY - PF_AMOUNT.
ENDFUNCTION.
