FUNCTION Z_SNEHA_FOODPRICE.
CASE FOODCHOICE.
  WHEN 1.
    FOODNAME = 'PIZZA'.
    PRICE = 250.
  WHEN 2.
    FOODNAME = 'BURGER'.
    PRICE = 120.
  WHEN 3.
    FOODNAME = 'PASTA'.
    PRICE = 180.
  WHEN 4.
    FOODNAME = 'SANDWITCH'.
    PRICE = 100.
  WHEN 5.
    FOODNAME = 'COFFEE'.
    PRICE = 80.
ENDCASE.
ENDFUNCTION.
