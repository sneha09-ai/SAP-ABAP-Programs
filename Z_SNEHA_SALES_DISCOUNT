FUNCTION Z_SNEHA_SALES_DISCOUNT.

  IF PURCHASE_AMOUNT < 1000.
    DISCOUNT = '0%'.
    FINAL_AMOUNT = PURCHASE_AMOUNT.

  ELSEIF PURCHASE_AMOUNT < 5000.
    DISCOUNT = '10%'.
    FINAL_AMOUNT = PURCHASE_AMOUNT - PURCHASE_AMOUNT / 10.

  ELSE.
    DISCOUNT = '20%'.
    FINAL_AMOUNT = PURCHASE_AMOUNT - PURCHASE_AMOUNT / 5.

  ENDIF.

ENDFUNCTION.
