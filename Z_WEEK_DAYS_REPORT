REPORT Z_WEEK_DAYS_REPORT.
PARAMETERS:
P_CHOICE TYPE I.

CASE P_CHOICE.
  WHEN 1.
    WRITE: 'MONDAY'.
  WHEN 2.
    WRITE: 'TUESDAY'.
  WHEN 3.
    WRITE: 'WEDNESDAY'.
  WHEN 4.
    WRITE: 'THRUSDAY'.
  WHEN 5.
    WRITE: 'FRIDAY'.
  WHEN 6.
    WRITE: 'SATURDAY'.
  WHEN 7.
    WRITE: 'SUNDAY'.
  WHEN OTHERS.
    WRITE: 'NOT FOUND'.
    ENDCASE.
